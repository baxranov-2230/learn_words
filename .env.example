# Postgres
POSTGRES_USER=learnwords
POSTGRES_PASSWORD=learnwords
POSTGRES_DB=learnwords

# Backend
DATABASE_URL=postgresql+asyncpg://learnwords:learnwords@postgres:5432/learnwords
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (stub — log holatida)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@learnwords.local
EMAIL_BACKEND=log

# App
APP_ENV=development
APP_DEBUG=true
APP_NAME=Learn Words

# Frontend
VITE_API_URL=http://localhost:8000
