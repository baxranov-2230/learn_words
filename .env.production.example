# ============================================
#  PRODUCTION uchun .env namunasi
#  Bu faylni .env ga nusxalang va qiymatlarni o'zgartiring:
#    cp .env.production.example .env
# ============================================

# --- Postgres (KUCHLI parol qo'ying!) ---
POSTGRES_USER=learnwords
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=learnwords

# DATABASE_URL va REDIS_URL docker-compose.prod.yml da avtomatik beriladi,
# bu yerda yozish shart emas.

# --- JWT (ALBATTA o'zgartiring — uzun tasodifiy satr) ---
# Yaratish:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Frontend va backend bitta domendan (nginx proxy) ishlagani uchun
# odatda kerak emas. Agar tashqi domen bo'lsa, shu yerga qo'shing.
CORS_ORIGINS=https://sizning-domeningiz.uz

# --- Email (haqiqiy SMTP kerak bo'lsa to'ldiring) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sizning-domeningiz.uz
EMAIL_BACKEND=log

# --- App ---
APP_ENV=production
APP_DEBUG=false
APP_NAME=Learn Words
