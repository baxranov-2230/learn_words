# ---- Build stage ----
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# VITE_API_URL bo'sh qoladi — frontend va backend bitta domendan ishlaydi (nginx proxy)
ENV VITE_API_URL=""
RUN npm run build

# ---- Runtime stage (nginx) ----
FROM nginx:1.27-alpine AS runtime

# SPA + API/uploads proxy konfiguratsiyasi
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Build qilingan statik fayllar
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
