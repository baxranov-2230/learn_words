# ---- 1. Build bosqichi ----
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Backend bitta domendan ishlaydi (nginx /api/ proxy) — URL kerak emas
ENV VITE_API_URL=""
RUN npm run build

# ---- 2. Nginx bosqichi ----
FROM nginx:1.27-alpine

# Nginx default config o'chiriladi
RUN rm /etc/nginx/conf.d/default.conf

# O'zimizning nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Vite build natijasi
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
